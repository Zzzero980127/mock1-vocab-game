rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 玩家公開資料（暱稱、頭像、等級、紀錄）：登入者都能讀，只有本人能寫
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      // 好友名單：本人能讀；加／刪好友時雙方都能寫對方名單裡「自己那一筆」
      // 房間邀請：任何登入者能寫進對方的 invites（from 必須是自己），只有本人能讀／刪
      match /invites/{iid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.resource.data.from == request.auth.uid;
      }
      match /friends/{fid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fid);
      }
    }
    // 好友代碼 → uid
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // 房間：登入者都能讀（用房間號加入）；只有房主能改房間；成員只能改自己的進度，加入時密碼雜湊要對、房間要在等待中
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && resource.data.host == request.auth.uid;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
          && get(/databases/$(db)/documents/rooms/$(code)).data.ph == request.resource.data.ph
          && get(/databases/$(db)/documents/rooms/$(code)).data.status == "waiting";
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || get(/databases/$(db)/documents/rooms/$(code)).data.host == request.auth.uid);
      }
    }
    // （舊版）一對一對戰：只有對戰雙方能讀寫
    match /matches/{id} {
      allow read, update: if request.auth != null && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.a == request.auth.uid;
    }
  }
}
